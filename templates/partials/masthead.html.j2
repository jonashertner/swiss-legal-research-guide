<header class="site-masthead" role="banner">
  <a class="brand" href="{{ site.base_path }}de/" aria-label="Zur Startseite">
    SUCHEN — LESEN — ANALYSIEREN
    <span class="version-pill">v. {{ site.version }}</span>
  </a>
  <button type="button" class="nav-toggle" aria-controls="primary-nav" aria-expanded="false" aria-label="Navigation öffnen">
    <span class="icon" aria-hidden="true">≡</span>
    <span class="label">Menü</span>
  </button>
  <nav id="primary-nav" class="primary-nav" aria-label="Hauptnavigation">
    {% for c in nav_chapters %}
      {% if c.slug != "einleitung" %}
      <a href="{{ c.url }}">{{ c.short_title }}</a>
      {% endif %}
    {% endfor %}
    <a class="ai-link" href="{{ site.base_path }}for-ai/">
      <span class="arrow">⌥</span> For AI / devs
    </a>
    <span class="lang-switch" aria-label="Sprache">
      <span class="lang active" lang="de" title="Deutsch">DE</span>
      <span class="lang muted" lang="fr" title="Français — folgt">FR</span>
      <span class="lang muted" lang="it" title="Italiano — folgt">IT</span>
    </span>
  </nav>
</header>
<div class="drawer-scrim" data-scrim hidden></div>
